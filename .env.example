# Postgres connection string (Neon, Supabase, Railway, or your own server)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tadesk"

# The public URL of the app, without a trailing slash
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admins: these people can always sign in, open every bootcamp and manage who else can sign in at /admin.
# Comma separated, compared lowercase. Admins listed here can't be removed from inside the app.
ADMIN_EMAILS=""

# Optional extra filter: people must also have one of these email domains (comma separated).
# Leave empty to allow any Google account an admin has added. Admins in ADMIN_EMAILS are never filtered.
ALLOWED_EMAIL_DOMAINS=""

# For automated tests only, not part of a normal setup. GOOGLE_MOCK=true logs emails and fakes Drive
# uploads instead of calling Google. Ignored in production builds.
# GOOGLE_MOCK="false"
